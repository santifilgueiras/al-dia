ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
PORT=5173

# Dashboard de Supabase -> Project Settings -> API. La URL y la anon key NO
# son secretas (están pensadas para vivir en el navegador), pero igual las
# ponemos acá para tener toda la config en un solo lugar.
SUPABASE_URL=https://TUPROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Service role key (Project Settings -> API -> "service_role secret") --
# ESTA SÍ ES SECRETA, nunca va al navegador. Solo la usa el server para leer
# push_subscriptions/app_state de TODOS los usuarios al disparar los
# recordatorios (bypassea RLS a propósito para eso).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Par de claves VAPID para web push -- se generan una sola vez con
# `node -e "console.log(require('web-push').generateVAPIDKeys())"` y no se
# vuelven a regenerar (si cambian, todas las suscripciones existentes quedan
# inválidas). VAPID_PUBLIC_KEY no es secreta (viaja al navegador),
# VAPID_PRIVATE_KEY sí.
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:tu-mail@ejemplo.com

# Secreto compartido con el cron externo (ej. cron-job.org) que dispara
# POST /api/push/send-reminders cada 15 min. Sin este secreto cualquiera
# podría spamear notificaciones a todos los usuarios.
PUSH_CRON_SECRET=...
